{
  "name": "@etamong-playground/ui",
  "version": "0.42.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etamong-playground/ui.git"
  },
  "description": "Shared frontend scaffold for etamong-lab apps — design tokens, cmdk command palette, toast/dialog primitives, deploy-version badge, PWA install, auth hooks, and responsive nav shell.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "pnpm --filter @etamong-playground/ui-showcase dev",
    "showcase:build": "pnpm --filter @etamong-playground/ui-showcase build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "es-hangul": "2.4.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40",
    "msw": ">=2",
    "pretendard": ">=1.3.9",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "pretendard": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.5",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
